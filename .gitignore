# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
dist-ssr/
build/
**/dist/
**/build/

# Environment variables (never commit secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
!.env.example
!**/.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Vite
.vite/
*.local

# Testing / coverage
coverage/
*.lcov

# Misc caches
.cache/
.eslintcache
.turbo/
.parcel-cache/

# Uploaded/generated assets not meant for version control (optional)
# Uncomment if you don't want to commit real product photos to git
# public/images/uploads/

# Backend-specific (once server/ exists)
server/uploads/
server/*.log